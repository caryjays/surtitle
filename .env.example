# Copy ONLY if .env does not already exist; never overwrite an existing credential file.
# Never put a key in a browser, URL, or profile.
# pnpm dev:listen explicitly forces local ASR + paid cloud text translation.
# pnpm preflight:listen checks presence only; no API calls.
# Optional: LOCAL_PREVIEWS=off disables provisional source work in listen mode.
# Default is local transcription and NO translation/API calls.
TRANSCRIPTION_BACKEND=local
TRANSLATION_BACKEND=off
LOCAL_MODEL=turbo-q4
LOCAL_MAX_TURN_MS=12000
# Experimental: rolling re-decodes about once a second and locks agreed text; turns is the default.
LOCAL_SEGMENTATION=turns
# Set cloud backends explicitly only when you want paid processing.
OPENAI_API_KEY=
# Needed only when TRANSLATION_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
TRANSCRIPTION_MODEL=gpt-live-transcribe
# Cloud translation provider: openai (default) or anthropic.
TRANSLATION_PROVIDER=openai
TRANSLATION_MODEL=gpt-5.6-terra
ANTHROPIC_TRANSLATION_MODEL=claude-haiku-5-5
# none disables reasoning/thinking. For anthropic, none and minimal map to effort low.
TRANSLATION_REASONING_EFFORT=none
# English and one other language with a profile in profiles/languages.json; only en-ja exists today.
LANGUAGE_PAIR=en-ja
PORT=4317
# Optional. Unset: private/glossary.json if present, else profiles/glossary.example.json.
GLOSSARY_PATH=
